            {
              "name": "pmid",
              "value": "={{ $('Szelekció').item.json.pmid }}"
            },
            {
              "name": "status",
              "value": "ok"
            },
            {
              "name": "path",
              "value": "={{ $('Szelekció').item.json.relpath }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "a2000000-0000-4000-8000-000000000007",
      "name": "Jelentés: kész",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -220
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.168:8765/downloads/report",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "pmid",

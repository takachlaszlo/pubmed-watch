{
  "name": "PubMed-figyelő – PDF-ek letöltése",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a2000000-0000-4000-8000-000000000001",
      "name": "Naponta 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://192.168.1.168:8765/downloads/due",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "hours",
              "value": "24"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "a2000000-0000-4000-8000-000000000002",
      "name": "Letöltendő cikkek (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// A letöltendők listáját és minden szabályt a PubMed-figyelő adja (config.yaml: downloads.sections, kinds,\n// preprints): hogy mely szekciók, hogy csak programból letölthető forrás, hogy csak az elmúlt 24 óra, és hogy a\n// már letöltöttet soha többé. Ez a node csak átadja a tételeket; szűrést itt csak kivételesen érdemes tenni.\n// A PDF-mappa az n8n konténerében (a compose-ban: ./shared:/files). A figyelő ugyanezt a mappát látja.\nconst ROOT = '/files/pubmed-pdf/';\n\nconst out = [];\n$input.all().forEach((item, i) => {\n  const a = item.json;\n  if (!a || !a.pmid || !a.download || !a.download.url || !a.download.path) return;\n  out.push({\n    json: { pmid: a.pmid, version: a.download.version || 'vor', reason: a.download.reason, title: a.title,\n            url: a.download.url, relpath: a.download.path, path: ROOT + a.download.path },\n    pairedItem: { item: i },\n  });\n});\nreturn out;"
      },
      "id": "a2000000-0000-4000-8000-000000000003",
      "name": "Szelekció",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a2000000-0000-4000-8000-000000000010",
      "name": "Egyenként",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "pubmed-watch/1.0 (+https://github.com/takachlaszlo/pubmed-watch)"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 120000
        }
      },
      "id": "a2000000-0000-4000-8000-000000000004",
      "name": "PDF letöltése",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c2000000-0000-4000-8000-000000000001",
              "leftValue": "={{ !!$binary.data && ($binary.data.fileExtension === 'pdf' || String($binary.data.mimeType || '').includes('pdf')) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a2000000-0000-4000-8000-000000000005",
      "name": "Tényleg PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        -80
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Egyenként').item.json.path }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "a2000000-0000-4000-8000-000000000006",
      "name": "Mentés a NAS-ra",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1320,
        -160
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.168:8765/downloads/report",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "pmid",
              "value": "={{ $('Egyenként').item.json.pmid }}"
            },
            {
              "name": "version",
              "value": "={{ $('Egyenként').item.json.version }}"
            },
            {
              "name": "status",
              "value": "ok"
            },
            {
              "name": "path",
              "value": "={{ $('Egyenként').item.json.relpath }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "a2000000-0000-4000-8000-000000000007",
      "name": "Jelentés: kész",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -220
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.168:8765/downloads/report",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "pmid",
              "value": "={{ $('Egyenként').item.json.pmid }}"
            },
            {
              "name": "version",
              "value": "={{ $('Egyenként').item.json.version }}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "stage",
              "value": "download"
            },
            {
              "name": "error",
              "value": "={{ $json.error ? String($json.error.message || $json.error) : 'nem PDF (' + (($binary && $binary.data && $binary.data.mimeType) || 'ismeretlen') + ')' }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "a2000000-0000-4000-8000-000000000008",
      "name": "Jelentés: letöltési hiba",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        140
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.168:8765/downloads/report",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "pmid",
              "value": "={{ $('Egyenként').item.json.pmid }}"
            },
            {
              "name": "version",
              "value": "={{ $('Egyenként').item.json.version }}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "stage",
              "value": "save"
            },
            {
              "name": "error",
              "value": "={{ String($json.error || 'ismeretlen mentési hiba') }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "a2000000-0000-4000-8000-000000000009",
      "name": "Jelentés: mentési hiba",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -60
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    }
  ],

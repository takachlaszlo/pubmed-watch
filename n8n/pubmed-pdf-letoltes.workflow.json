{
  "name": "PubMed-figyelő – PDF-ek letöltése",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a2000000-0000-4000-8000-000000000001",
      "name": "Naponta 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://192.168.1.168:8765/downloads/due",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "hours",
              "value": "24"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "a2000000-0000-4000-8000-000000000002",
      "name": "Letöltendő cikkek (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// === SZELEKCIÓS SZABÁLYOK – itt módosíthatók ===\n// Melyik levélszekciók PDF-jét töltsük le automatikusan?\n//   iranyelvek | gyermek-ams | gyermekinfektologia | review-gyermek | review-infektologia | innovacio | vizsgalatok\nconst SECTIONS = ['iranyelvek', 'gyermek-ams', 'gyermekinfektologia'];\n// Opcionális további feltétel a cikktípusra (pl. ['guideline','systematic_review']); üres = bármi.\nconst KINDS = [];\n// Csak olyan forrásból töltünk le, amelyet program is elérhet. A Europe PMC webes PDF-je és a legtöbb kiadói\n// oldal böngészőellenőrzés mögött van, azok a levélben kattintható linkek maradnak.\nconst SOURCES = ['pmc-s3', 'unpaywall'];\n// A PDF-mappa az n8n konténerében (a compose-ban: ./shared:/files). A figyelő ugyanezt a mappát látja.\nconst ROOT = '/files/pubmed-pdf/';\n// ==============================================\n// Az n8n nem tud mappát létrehozni, ezért minden PDF az _inbox mappába kerül; a figyelő a jelentés után\n// a végleges folyóirat/issue mappába teszi át. A \"download\" mezőt a figyelő számolja (új cikk az elmúlt\n// 24 órából, vagy a havi újrapróbálás esedékes), a már letöltöttet sosem ajánlja fel újra.\n\nconst out = [];\n$input.all().forEach((item, i) => {\n  const a = item.json;\n  if (!a || !a.pmid || !a.links || !a.links.pdf || !a.download) return;\n  if (!SECTIONS.includes(a.section)) return;\n  if (KINDS.length && !KINDS.includes(a.kind)) return;\n  if (!SOURCES.includes(a.pdf_source)) return;\n  out.push({\n    json: { pmid: a.pmid, section: a.section, title: a.title, reason: a.download.reason, pdfUrl: a.links.pdf,\n            relpath: a.download.path, path: ROOT + a.download.path },\n    pairedItem: { item: i },\n  });\n});\nreturn out;"
      },
      "id": "a2000000-0000-4000-8000-000000000003",
      "name": "Szelekció",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.pdfUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "pubmed-watch/1.0 (+https://github.com/takachlaszlo/pubmed-watch)"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 500
            }
          }
        }
      },
      "id": "a2000000-0000-4000-8000-000000000004",
      "name": "PDF letöltése",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c2000000-0000-4000-8000-000000000001",
              "leftValue": "={{ !!$binary.data && ($binary.data.fileExtension === 'pdf' || String($binary.data.mimeType || '').includes('pdf')) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a2000000-0000-4000-8000-000000000005",
      "name": "Tényleg PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        -80
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Szelekció').item.json.path }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "a2000000-0000-4000-8000-000000000006",
      "name": "Mentés a NAS-ra",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1100,
        -160
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.168:8765/downloads/report",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
